# Copia a .env.deploy y rellena con los datos de tu EC2
# No subas .env.deploy al repo si contiene datos sensibles (añádelo a .gitignore)

DEPLOY_SSH_HOST=ec2-xx-xx-xx-xx.compute.amazonaws.com
DEPLOY_SSH_USER=ubuntu
DEPLOY_REMOTE_PATH=/home/ubuntu/earlymarketreports

# Clave .pem para acceder al EC2 (ruta absoluta o relativa al proyecto)
DEPLOY_SSH_KEY=/ruta/a/tu-clave.pem
