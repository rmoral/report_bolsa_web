# ============================================================
# SOCIAL MEDIA AUTOMATION - Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials

# ── OPENAI ───────────────────────────────────────────────
# API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Model to use for content generation (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini
# Image generation model (default: dall-e-3 | options: dall-e-3, dall-e-2)
OPENAI_IMAGE_MODEL=dall-e-3
# Enable/disable image generation for posts (true/false)
GENERATE_IMAGES=true

# ── NEWS SOURCES ──────────────────────────────────────────
# Brave Search API: https://api.search.brave.com/
# Plans: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# NewsAPI: https://newsapi.org/ (optional, Brave is preferred)
NEWSAPI_KEY=your_newsapi_key_here

# ── TELEGRAM BOT ─────────────────────────────────────────
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram user ID (get it from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# ── TWITTER / X ──────────────────────────────────────────
# Developer portal: https://developer.twitter.com
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ── LINKEDIN ─────────────────────────────────────────────
# Developer portal: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
# Your LinkedIn Person URN (urn:li:person:XXXXXXXX)
LINKEDIN_PERSON_URN=urn:li:person:your_person_id

# ── INSTAGRAM ─────────────────────────────────────────────
# Meta Developer portal: https://developers.facebook.com
# Uses Instagram Graph API (requires Facebook Page + Instagram Business account)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
# Alternative: direct login (instagrapi fallback)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ── SCHEDULING ────────────────────────────────────────────
# Time to run daily automation (24h format, UTC)
DAILY_RUN_HOUR=7
DAILY_RUN_MINUTE=0
# Timezone for scheduling (e.g. Europe/Madrid, America/New_York)
TIMEZONE=Europe/Madrid

# ── BRANDING ─────────────────────────────────────────────
# URL appended to every post on X and LinkedIn
WEBSITE_URL=https://earlymarketreports.com

# ── CONTENT SETTINGS ─────────────────────────────────────
# Number of top news items to process per run
MAX_NEWS_ITEMS=5
# Language for generated content (es=Spanish, en=English)
CONTENT_LANGUAGE=en
# Auto-publish without Telegram approval (true/false)
AUTO_PUBLISH=false

# ── DATABASE ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///social_automation.db
