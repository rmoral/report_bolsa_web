# ============================================================
# SOCIAL MEDIA AUTOMATION - Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials

# ── OPENAI ───────────────────────────────────────────────
# API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Model to use for content generation (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini
# Image generation model (default: dall-e-3 | options: dall-e-3, dall-e-2)
OPENAI_IMAGE_MODEL=dall-e-3
# Enable/disable image generation for posts (true/false)
GENERATE_IMAGES=true

# ── NEWS SOURCES ──────────────────────────────────────────
# Brave Search API: https://api.search.brave.com/
# Plans: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# NewsAPI: https://newsapi.org/ (optional, Brave is preferred)
NEWSAPI_KEY=your_newsapi_key_here

# ── TELEGRAM BOT ─────────────────────────────────────────
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram user ID (get it from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# ── TWITTER / X ──────────────────────────────────────────
# Developer portal: https://developer.twitter.com
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ── LINKEDIN ─────────────────────────────────────────────
# Developer portal: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
# Your LinkedIn Person URN (urn:li:person:XXXXXXXX)
LINKEDIN_PERSON_URN=urn:li:person:your_person_id

# ── INSTAGRAM ─────────────────────────────────────────────
# Meta Developer portal: https://developers.facebook.com
# Uses Instagram Graph API (requires Facebook Page + Instagram Business account)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
# Alternative: direct login (instagrapi fallback)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ── SCHEDULING ────────────────────────────────────────────
# Morning run: fetch news + generate posts for X (24h, local timezone)
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0
# Afternoon run: second daily batch (set AFTERNOON_RUN_HOUR=-1 to disable)
AFTERNOON_RUN_HOUR=14
AFTERNOON_RUN_MINUTE=0
# Timezone for scheduling (e.g. Europe/Madrid, America/New_York)
TIMEZONE=Europe/Madrid

# ── BRANDING ─────────────────────────────────────────────
# URL appended to every post on X and LinkedIn
WEBSITE_URL=https://earlymarketreports.com

# ── CONTENT SETTINGS ─────────────────────────────────────
# Number of top news items to process per run
MAX_NEWS_ITEMS=5
# Language for generated content (es=Spanish, en=English)
CONTENT_LANGUAGE=en
# Auto-publish without Telegram approval (true/false)
AUTO_PUBLISH=false

# ── IMAGE GENERATION ──────────────────────────────────────
# Provider: "dalle" (OpenAI DALL-E 3) | "imagen3" (Google Nano Banana)
IMAGE_PROVIDER=dalle
# Google AI API key — required only when IMAGE_PROVIDER=imagen3
# Get it free at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key

# ── PAYLOAD CMS (blog) ───────────────────────────────────
# URL path used to build article links in announcement tweets
# Result: https://earlymarketreports.com/{BLOG_URL_PREFIX}/{slug}
BLOG_URL_PREFIX=blog
# Base URL of your Payload CMS instance (no trailing slash)
PAYLOAD_API_URL=https://earlymarketreports.com
# Admin user credentials for Payload CMS
PAYLOAD_EMAIL=admin@earlymarketreports.com
PAYLOAD_PASSWORD=your_payload_admin_password

# ── YOUTUBE ──────────────────────────────────────────────
# Display name of your channel (used inside generated scripts)
YOUTUBE_CHANNEL_NAME=Early Market Reports
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=youtube_client_secrets.json
# Path where the OAuth token is stored after running setup_oauth.py
YOUTUBE_TOKEN_FILE=youtube_token.json
# Privacy for uploaded videos: private | unlisted | public
# Start with "private" to review before publishing
YOUTUBE_DEFAULT_PRIVACY=private

# ── HEYGEN (AI video generation) ─────────────────────────
# API key from app.heygen.com → Settings → API
HEYGEN_API_KEY=your_heygen_api_key
# Avatar ID — run /yt_avatars in Telegram to see available IDs
HEYGEN_AVATAR_ID=your_avatar_id
# Voice ID — run /yt_voices in Telegram to see available IDs
HEYGEN_VOICE_ID=your_voice_id
# Background colour for the avatar (hex, default dark blue)
HEYGEN_BACKGROUND_COLOR=#1a1a2e
# Test mode: generates watermarked video for free (true/false)
HEYGEN_TEST_MODE=true

# ── DATABASE ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///social_automation.db
