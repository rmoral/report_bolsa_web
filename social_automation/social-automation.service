[Unit]
Description=Social Media Automation System
Documentation=https://github.com/rmoral/report_bolsa_web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/web/report_bolsa_web/social_automation
ExecStart=/home/ubuntu/web/report_bolsa_web/.venv/bin/python main.py
Restart=always
RestartSec=15
# Limit restart loops: max 5 restarts in 5 minutes
StartLimitBurst=5
StartLimitIntervalSec=300

# Environment
EnvironmentFile=/home/ubuntu/web/report_bolsa_web/social_automation/.env

# Logging — readable with: journalctl -u social-automation -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=social-automation

# Give the process time to shut down gracefully (Telegram bot needs ~10 s)
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
